<misc:NotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.ToolsetDev.ShaderComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:exportLoaderControls="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls"
        xmlns:materialViewer="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls.MaterialViewer"
        xmlns:hb1="clr-namespace:Be.Windows.Forms;assembly=Be.Windows.Forms.HexBox"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        mc:Ignorable="d"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Shader Comparison" Height="800" Width="1400">
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4">
                    <MenuItem Header="Load Left Package..." Click="LoadLeftPackage_Click"/>
                    <MenuItem Header="Load Right Package..." Click="LoadRightPackage_Click"/>
                    <Separator/>
                    <MenuItem Header="Close" Click="Close_Click"/>
                </MenuItem>
                <MenuItem Header="Operations" Padding="4">
                    <MenuItem Header="Copy shader parameters" Click="CopyShaderParameters_Click"/>
                    <MenuItem Header="Get shader info" Click="GetShaderInfo_Click"/>
                </MenuItem>
            </Menu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LeftPackageName, FallbackValue='No package loaded'}" 
                               FontWeight="Bold" Margin="4" />
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                        <TextBlock Text="Material: " VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding LeftMaterials}" 
                                  SelectedItem="{Binding SelectedLeftMaterial}"
                                  DisplayMemberPath="InstancedFullPath" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                        <TextBlock Text="Shader: " VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding LeftShaders}" 
                                  SelectedItem="{Binding SelectedLeftShader}"
                                  DisplayMemberPath="Description" />
                    </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabControl Grid.Row="0">
                            <TabItem Header="HLSL">
                                <materialViewer:HlslTextEditor x:Name="LeftShaderTextEditor"
                                                               Document="{Binding LeftDocument}"
                                                               Background="#1F1F1F" Foreground="#CCCCCC" 
                                                               LineNumbersForeground="#6E7681"
                                                               FontFamily="Consolas" IsReadOnly="True"/>
                            </TabItem>
                            <TabItem Header="Bytecode">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding LeftBytecodeMatchText}" Margin="4,2" FontWeight="Bold"
                                               Foreground="{Binding LeftBytecodeMatchBrush}"/>
                                    <sharedUi:WindowsFormsHostEx x:Name="LeftHexBoxHost">
                                        <hb1:HexBox MinBytesPerLine="4" MaxBytesPerLine="16" ColumnInfoVisible="True" LineInfoVisible="True"
                                                    Font="Courier New,10" StringViewVisible="True" VScrollBarVisible="True" ReadOnly="True"/>
                                    </sharedUi:WindowsFormsHostEx>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="Parameter Bindings" FontWeight="Bold" Margin="4,2"/>
                            <TreeView ItemsSource="{Binding LeftParameterNodes}" FontFamily="Consolas" FontSize="11">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type exportLoaderControls:BinInterpNode}"
                                                              ItemsSource="{Binding Items}">
                                        <TextBlock Text="{Binding Header}" Background="{Binding DiffBackground}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                <!-- Right Panel -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RightPackageName, FallbackValue='No package loaded'}" 
                               FontWeight="Bold" Margin="4" />
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                        <TextBlock Text="Material: " VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding RightMaterials}" 
                                  SelectedItem="{Binding SelectedRightMaterial}"
                                  DisplayMemberPath="InstancedFullPath" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                        <TextBlock Text="Shader: " VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding RightShaders}" 
                                  SelectedItem="{Binding SelectedRightShader}"
                                  DisplayMemberPath="Description" />
                    </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabControl Grid.Row="0">
                            <TabItem Header="HLSL">
                                <materialViewer:HlslTextEditor x:Name="RightShaderTextEditor"
                                                               Document="{Binding RightDocument}"
                                                               Background="#1F1F1F" Foreground="#CCCCCC" 
                                                               LineNumbersForeground="#6E7681"
                                                               FontFamily="Consolas" IsReadOnly="True"/>
                            </TabItem>
                            <TabItem Header="Bytecode">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding RightBytecodeMatchText}" Margin="4,2" FontWeight="Bold"
                                               Foreground="{Binding RightBytecodeMatchBrush}"/>
                                    <sharedUi:WindowsFormsHostEx x:Name="RightHexBoxHost">
                                        <hb1:HexBox MinBytesPerLine="4" MaxBytesPerLine="16" ColumnInfoVisible="True" LineInfoVisible="True"
                                                    Font="Courier New,10" StringViewVisible="True" VScrollBarVisible="True" ReadOnly="True"/>
                                    </sharedUi:WindowsFormsHostEx>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="Parameter Bindings" FontWeight="Bold" Margin="4,2"/>
                            <TreeView ItemsSource="{Binding RightParameterNodes}" FontFamily="Consolas" FontSize="11">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type exportLoaderControls:BinInterpNode}"
                                                              ItemsSource="{Binding Items}">
                                        <TextBlock Text="{Binding Header}" Background="{Binding DiffBackground}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</misc:NotifyPropertyChangedWindowBase>
