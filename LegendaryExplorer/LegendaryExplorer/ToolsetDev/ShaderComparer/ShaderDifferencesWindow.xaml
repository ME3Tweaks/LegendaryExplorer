<Window x:Class="LegendaryExplorer.ToolsetDev.ShaderComparer.ShaderDifferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Differing Shaders" Height="400" Width="400">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Double-click an item to select it in the left panel" Margin="0,0,0,8"/>
        <ListBox x:Name="ListBoxShaders" MouseDoubleClick="ListBoxShaders_MouseDoubleClick"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Click="Close_Click" MinWidth="80"/>
        </StackPanel>
    </DockPanel>
</Window>
