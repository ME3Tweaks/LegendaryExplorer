<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Dialogs.CheckedListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Select Items" Width="500" Height="450">
    <DockPanel Margin="10" LastChildFill="True">
        <TextBlock Text="{Binding TopText}" TextWrapping="Wrap" DockPanel.Dock="Top" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Select All" Click="SelectAll_Click" Padding="8,4" Margin="0,0,5,0"/>
            <Button Content="Select None" Click="SelectNone_Click" Padding="8,4" Margin="0,0,15,0"/>
            <Button Content="OK" Click="OK_Click" IsDefault="True" Padding="20,4" Margin="0,0,5,0"/>
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Padding="20,4"/>
        </StackPanel>
        <xctk:CheckListBox x:Name="CheckList" ItemsSource="{Binding Items}" DisplayMemberPath="DisplayName" SelectedMemberPath="IsSelected"/>
    </DockPanel>
</bases:TrackingNotifyPropertyChangedWindowBase>
