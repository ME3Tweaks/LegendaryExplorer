<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic dark-theme brush palette. Keep this list minimal - only add a new key when an
         existing one genuinely doesn't fit, so Controls.Shared.xaml / Controls.Xceed.xaml stay easy to reason about. -->

    <Color x:Key="Theme.Color.Accent">#FF3794FF</Color>
    <Color x:Key="Theme.Color.Selected">#FF094771</Color>
    <Color x:Key="Theme.Color.OnAccent">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Theme.Background.Window" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="Theme.Background.Panel" Color="#FF252526"/>
    <SolidColorBrush x:Key="Theme.Background.Control" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="Theme.Background.ControlHover" Color="#FF454545"/>
    <SolidColorBrush x:Key="Theme.Background.ControlPressed" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Theme.Background.Selected" Color="#FF094771"/>
    <SolidColorBrush x:Key="Theme.Background.Overlay" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Theme.Background.InfoBar" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Theme.Background.HeaderLabel" Color="#FF252526"/>
    <SolidColorBrush x:Key="Theme.Background.ReadOnly" Color="#FF2A2A2C"/>
    <!-- Plain gray instead of a dark-tuned yellow - the Asset Database texture preview pane's yellow tint
         only ever existed to read fine with dark text; readability doesn't depend on keeping the hue. -->
    <SolidColorBrush x:Key="Theme.Background.TexturePreview" Color="#FF3C3C3C"/>

    <SolidColorBrush x:Key="Theme.Foreground.Primary" Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="Theme.Foreground.Secondary" Color="#FF9D9D9D"/>
    <SolidColorBrush x:Key="Theme.Foreground.Disabled" Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="Theme.Foreground.OnAccent" Color="#FFFFFFFF"/>

    <!-- Noticeably lighter than Theme.Background.Control (#3C3C3C) on purpose - the original #3F3F46 was
         nearly the same brightness, so bordered controls like TextBox read as flat blocks with no visible
         edge, making them hard to tell apart from static/non-interactive elements. -->
    <SolidColorBrush x:Key="Theme.Border" Color="#FF6B6B70"/>
    <SolidColorBrush x:Key="Theme.BorderFocus" Color="{StaticResource Theme.Color.Accent}"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="{StaticResource Theme.Color.Accent}"/>
    <SolidColorBrush x:Key="Theme.Foreground.IconAccent" Color="{StaticResource Theme.Color.Accent}"/>
    <!-- Same darker orange chosen for the Sequence Editor toolbox expander - full "Orange" reads too
         strong against the dark background. -->
    <SolidColorBrush x:Key="Theme.Accent.Warm" Color="#FFB36B00"/>

    <SolidColorBrush x:Key="Theme.Error" Color="#FFF14C4C"/>

    <!-- Solid "Yellow" (the literal used app-wide for the "modified/pending changes" row highlight) reads
         as a wall of glare once a package has more than a couple dirty entries. Semi-transparent instead
         of a flat darker yellow so it blends with whatever's underneath (selection, hover) rather than
         fighting it, while staying recognizably the same hue as light mode's full-strength version. -->
    <SolidColorBrush x:Key="Theme.Background.Modified" Color="#8DFFD700"/>

</ResourceDictionary>
