<UserControl x:Class="LegendaryExplorer.UserControls.SharedToolControls.HexEditor.HexEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls.HexEditor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Focusable="True"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Line Info -->
            <ColumnDefinition Width="*"/>
            <!-- Content -->
            <ColumnDefinition Width="Auto"/>
            <!-- ScrollBar -->
        </Grid.ColumnDefinitions>

        <!-- Line Info Panel -->
        <Border x:Name="LineInfoBorder" 
                Grid.Column="0" 
                BorderThickness="0,0,1,0" 
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource InfoBackgroundBrush}"
                Visibility="{Binding LineInfoVisible, RelativeSource={RelativeSource AncestorType=local:HexEditorControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Canvas x:Name="LineInfoCanvas" 
                    MinWidth="80"
                    ClipToBounds="True"/>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Column Info -->
                <RowDefinition Height="*"/>
                <!-- Hex and String View -->
            </Grid.RowDefinitions>

            <!-- Column Info Header -->
            <Border x:Name="ColumnInfoBorder" 
                    Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding ColumnInfoVisible, RelativeSource={RelativeSource AncestorType=local:HexEditorControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                <Canvas x:Name="ColumnInfoCanvas" 
                        Height="20"
                        ClipToBounds="True"/>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Hex View -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- String View -->
                </Grid.ColumnDefinitions>

                <!-- Hex View Canvas -->
                <Canvas x:Name="HexCanvas" 
                        Grid.Column="0"
                        ClipToBounds="True"
                        Focusable="True"
                        Background="Transparent"
                        MouseDown="HexCanvas_MouseDown"
                        MouseMove="HexCanvas_MouseMove"
                        MouseUp="HexCanvas_MouseUp"/>

                <!-- String View Canvas -->
                <Border Grid.Column="1"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding StringViewVisible, RelativeSource={RelativeSource AncestorType=local:HexEditorControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Canvas x:Name="StringCanvas"
                            ClipToBounds="True"
                            Focusable="True"
                            Background="Transparent"
                            MouseDown="StringCanvas_MouseDown"
                            MouseMove="StringCanvas_MouseMove"
                            MouseUp="StringCanvas_MouseUp"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Vertical ScrollBar -->
        <ScrollBar x:Name="VerticalScrollBar" 
                   Grid.Column="2"
                   Orientation="Vertical"
                   Visibility="{Binding VScrollBarVisible, RelativeSource={RelativeSource AncestorType=local:HexEditorControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                   Minimum="0"
                   Maximum="100"
                   ViewportSize="10"
                   SmallChange="1"
                   LargeChange="10"
                   Scroll="VerticalScrollBar_Scroll"/>

        <!-- Caret -->
        <Rectangle x:Name="Caret"
                   Width="2"
                   Height="14"
                   Fill="{DynamicResource TextBrush}"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Panel.ZIndex="100"/>
    </Grid>
</UserControl>
