<bases:TrackingNotifyPropertyChangedWindowBase x:Class="LegendaryExplorer.Tools.LevelEditor.AssetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:assetDatabase="clr-namespace:LegendaryExplorer.Tools.AssetDatabase"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.LevelEditor"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="{Binding PickTitle}" Width="1180" Height="720" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource EditorChrome}" Foreground="{DynamicResource EditorText}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LevelEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <!-- Where an asset is. A mod's is meant to be hard to miss -->
            <Style x:Key="SourceBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#3E3E3E"/>
                <Setter Property="BorderBrush" Value="#3E3E3E"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Origin}" Value="{x:Static assetDatabase:AssetOrigin.ThisFile}">
                        <Setter Property="Background" Value="#2F5D3A"/><Setter Property="BorderBrush" Value="#2F5D3A"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Origin}" Value="{x:Static assetDatabase:AssetOrigin.DLC}">
                        <Setter Property="Background" Value="#2D4E78"/><Setter Property="BorderBrush" Value="#2D4E78"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Origin}" Value="{x:Static assetDatabase:AssetOrigin.Mod}">
                        <Setter Property="Background" Value="#B8420E"/><Setter Property="BorderBrush" Value="#FDBA74"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SourceBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Origin}" Value="{x:Static assetDatabase:AssetOrigin.Mod}">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- One choice: its name and path, and where it is -->
            <DataTemplate x:Key="ChoiceRow" DataType="{x:Type local:AssetChoice}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding InstancedFullPath}" Foreground="{StaticResource EditorMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SourceBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource SourceBadgeText}"/>
                    </Border>
                </Grid>
            </DataTemplate>
            <Style x:Key="ViewOption" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinWidth" Value="64"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <RadioButton Content="List" GroupName="View" Style="{StaticResource ViewOption}" IsChecked="{Binding ShowList}" ToolTip="Every asset, by name"/>
                <RadioButton Content="Folders" GroupName="View" Style="{StaticResource ViewOption}" Margin="4,0,0,0" IsChecked="{Binding ShowFolders}"
                             ToolTip="The assets in folders by path: their packages and groups"/>
            </StackPanel>
            <xctk:WatermarkTextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                   Watermark="Search by name, path, package, source or file"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Open Asset Database" Margin="8,0,0,0" Click="OpenAssetDatabase_Click"
                    Visibility="{Binding CanOpenDatabase, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Build or rebuild the game's asset database there, then pick again"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Use" MinWidth="80" IsDefault="True" Click="Use_Click" IsEnabled="{Binding CanUse, Converter={StaticResource BoolEnabledConverter}}"/>
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="440" MinWidth="260"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ChoiceList" ItemsSource="{Binding VisibleChoices}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource ChoiceRow}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                     MouseDoubleClick="ChoiceList_MouseDoubleClick" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderRoots}" Background="{StaticResource EditorPanel}" Foreground="{StaticResource EditorText}" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItemChanged="FolderTree_SelectedItemChanged" MouseDoubleClick="FolderTree_MouseDoubleClick"
                      Visibility="{Binding ShowFolders, Converter={StaticResource BoolToVisibilityConverter}}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:AssetFolder}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="{StaticResource EditorMuted}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type local:AssetChoice}">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ChoiceRow}" Margin="0,2"/>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <!-- A folder starts expanded when a search narrows the tree; a choice has no IsExpanded, and isn't expandable -->
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2" Background="{StaticResource EditorPanel}">
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock Text="{Binding SelectedName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding SelectedPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0"
                             Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedDetails}" Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedProblem}" Foreground="#F59E8B" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasSelectedProblem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6"
                            Visibility="{Binding IsMaterialPick, Converter={StaticResource BoolToVisibilityConverter}}">
                    <RadioButton Content="Sphere" GroupName="Shape" Style="{StaticResource ViewOption}" IsChecked="{Binding ShowOnSphere}"/>
                    <RadioButton Content="Cube" GroupName="Shape" Style="{StaticResource ViewOption}" Margin="4,0,0,0" IsChecked="{Binding ShowOnCube}"/>
                    <RadioButton Content="Plane" GroupName="Shape" Style="{StaticResource ViewOption}" Margin="4,0,0,0" IsChecked="{Binding ShowOnPlane}"/>
                </StackPanel>
                <Grid>
                    <scene3D:SceneRenderControl x:Name="PreviewViewer"/>
                    <!-- Over the viewport rather than hiding it, which keeps its device and size -->
                    <Border Background="{StaticResource EditorPanel}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}">
                        <TextBlock Text="{Binding PreviewNote}" Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</bases:TrackingNotifyPropertyChangedWindowBase>
