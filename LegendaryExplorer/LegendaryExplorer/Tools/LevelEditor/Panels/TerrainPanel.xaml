<UserControl x:Class="LegendaryExplorer.Tools.LevelEditor.TerrainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
             xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:fa="http://schemas.fontawesome.com/icons/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../LevelEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
            <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
            <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Background="{StaticResource EditorPanel}" IsEnabled="{Binding HasAnyFileOpen, Converter={StaticResource BoolEnabledConverter}}">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SculptStatus}" Visibility="{Binding SculptStatus, Converter={StaticResource NullVisibilityConverter}}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="9,7"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <TextBlock Text="Sculpt" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SculptOptions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Data.ToggleSculptCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,1,0,0" AutomationProperties.Name="{Binding Name, StringFormat='Sculpt: {0}'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditorButtonBase}">
                                        <Setter Property="ToolTip" Value="Click, then drag on a terrain"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource EditorAccent}"/>
                                                <Setter Property="ToolTip" Value="Sculpting: drag on a terrain. Click here again, or press Esc, to stop"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel>
                                    <fa:ImageAwesome DockPanel.Dock="Left" Icon="{Binding Icon}" Width="12" Height="12" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{StaticResource EditorText}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Brush" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="37"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                    <TextBlock Text="Radius" VerticalAlignment="Center" ToolTip="How far from its centre the brush works at full strength"/>
                    <xctk:SingleUpDown Grid.Column="1" Value="{Binding SculptRadius}" Minimum="0" DefaultValue="512" DisplayDefaultValueOnEmptyText="True" Increment="64" FormatString="F0" VerticalAlignment="Center" AutomationProperties.Name="Brush radius"/>
                    <TextBlock Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource EditorMuted}"/>
                    <TextBlock Grid.Row="1" Text="Falloff" VerticalAlignment="Center" ToolTip="How far beyond the radius the brush fades to nothing"/>
                    <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SculptFalloff}" Minimum="0" DefaultValue="512" DisplayDefaultValueOnEmptyText="True" Increment="64" FormatString="F0" VerticalAlignment="Center" AutomationProperties.Name="Brush falloff"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource EditorMuted}"/>
                    <TextBlock Grid.Row="2" Text="Strength" VerticalAlignment="Center" ToolTip="UE3's tool strength: raise / lower moves the brush's centre about ten times this many units a second"/>
                    <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SculptStrength}" Minimum="0" DefaultValue="100" DisplayDefaultValueOnEmptyText="True" Increment="10" FormatString="F0" VerticalAlignment="Center" AutomationProperties.Name="Brush strength"/>
                </Grid>
                <TextBlock Text="Sculpting changes the terrain's heights, holes and collision when committed. Its baked lighting isn't made again until the level is rebaked." TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
