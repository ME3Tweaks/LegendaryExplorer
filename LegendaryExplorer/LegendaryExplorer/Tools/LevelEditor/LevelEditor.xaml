<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Tools.LevelEditor.LevelEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        xmlns:local="clr-namespace:LegendaryExplorer.Tools.LevelEditor"
        xmlns:scene3D="clr-namespace:LegendaryExplorer.Tools.LevelEditor.Scene3D"
        xmlns:lightmass="clr-namespace:LegendaryExplorer.Lightmaps.Lightmass"
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        Icon="pack://application:,,,/Tools/Icons/16x16/LiveLevelEditor_Icon_16.ico"
        DragOver="Window_DragOver" Drop="Window_Drop" AllowDrop="True"
        Loaded="LevelEditor_Loaded" Closing="LevelEditor_Closing" mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Level Editor" Height="920" Width="1440" MinHeight="650" MinWidth="1080"
        Background="{DynamicResource EditorChrome}" Foreground="{DynamicResource EditorText}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LevelEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
            <converters:BoolEnabledConverter x:Key="BoolEnabledConverter"/>
            <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
            <converters:GameToImageIconConverter x:Key="GameToImageIconConverter"/>
            <sharedUi:BindingProxy x:Key="bindingProxy" Data="{Binding}"/>
            <local:OutlinerGroupStateConverter x:Key="OutlinerGroupStateConverter"/>
            <Style x:Key="OutlinerGroupExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite" Style="{StaticResource EditorButtonBase}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.Name="Expand or collapse group">
                                    <DockPanel>
                                        <TextBlock x:Name="Arrow" Text="›" Width="14" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <ContentPresenter ContentSource="Header"/>
                                    </DockPanel>
                                </ToggleButton>
                                <ContentPresenter x:Name="GroupItems" ContentSource="Content" Visibility="Collapsed" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="GroupItems" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Arrow" Property="Text" Value="⌄"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="fa:ImageAwesome"><Setter Property="Foreground" Value="{StaticResource EditorText}"/></Style>
            <Style x:Key="CommitButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Background" Value="{StaticResource EditorAccent}"/></DataTrigger></Style.Triggers>
            </Style>
            <DataTemplate x:Key="OutlinerLevelHeader">
                <Border Background="{StaticResource EditorChrome}" Padding="6,4" Margin="0,3,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Data.CanEditScene, Source={StaticResource bindingProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border IsEnabled="{Binding Name.CanChangeReadOnly}">
                            <ToggleButton Padding="4" IsEnabled="{Binding Data.CanEditScene, Source={StaticResource bindingProxy}}" IsChecked="{Binding Name.IsReadOnly, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Read-only package">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="ToolTip" Value="Read-only: prevent actor edits"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Name.CanChangeReadOnly}" Value="False"><Setter Property="ToolTip" Value="Read-only is unavailable while the file has new or deleted actors to commit"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid Width="11" Height="12">
                                    <fa:ImageAwesome Icon="Solid_Lock" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{StaticResource EditorText}"/>
                                    <fa:ImageAwesome Icon="Solid_LockOpen" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}" Foreground="{StaticResource EditorText}"/>
                                </Grid>
                            </ToggleButton>
                            </Border>
                            <Button Command="{Binding Data.SaveSingleFileCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding Name}" Style="{StaticResource EditorCompactButton}" ToolTip="Save this package" AutomationProperties.Name="Save package"><fa:ImageAwesome Icon="Regular_Save" Width="11" Foreground="{StaticResource EditorText}"/></Button>
                            <Button Command="{Binding Data.CloseFileCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding Name}" Style="{StaticResource EditorCompactButton}" ToolTip="Close this package" AutomationProperties.Name="Close package"><fa:ImageAwesome Icon="Solid_Times" Width="10" Foreground="{StaticResource EditorText}"/></Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Name.FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name.FilePath}" VerticalAlignment="Center" FontSize="11"/>
                    </DockPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="OutlinerCategoryHeader">
                <Border Background="{StaticResource EditorRaised}" Padding="8,6" Margin="0,5,0,1">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0" Style="{StaticResource EditorButtonBase}"
                                      IsChecked="{Binding DataContext.Category.IsVisible, RelativeSource={RelativeSource AncestorType=Expander}, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in viewport'}" ToolTip="Show or hide this category in the viewport">
                            <Grid Width="13" Height="13">
                                <fa:ImageAwesome Icon="Regular_Eye" Foreground="{StaticResource EditorText}" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <fa:ImageAwesome Icon="Regular_EyeSlash" Foreground="{StaticResource EditorMuted}" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                            </Grid>
                        </ToggleButton>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Foreground="{StaticResource EditorMuted}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
            </DataTemplate>
            <ContextMenu x:Key="ActorContextMenu" Opened="ActorContextMenu_Opened">
                <MenuItem Header="Delete Actor" Command="{Binding Data.DeleteActorCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}" InputGestureText="Delete" ToolTip="{Binding DeleteRefusal}" ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Upgrade to Actor" Command="{Binding Data.UpgradeActorCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}" Visibility="{Binding IsCollectionMember, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding UpgradeRefusal}" ToolTipService.ShowOnDisabled="True"/>
                <MenuItem Header="Focus Camera" Command="{Binding Data.FocusSelectedCommand, Source={StaticResource bindingProxy}}" InputGestureText="F"/>
                <MenuItem Header="Open in Package Editor" Visibility="{Binding Data.CanEditScene, Source={StaticResource bindingProxy}, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding Data.OpenInPackageEditorCommand, Source={StaticResource bindingProxy}}"/>
            </ContextMenu>
            <Style x:Key="ActorRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="ContextMenu" Value="{StaticResource ActorContextMenu}"/>
                <Setter Property="ToolTip" Value="{Binding CoverageToolTip}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <xctk:BusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel Background="{StaticResource EditorChrome}">
            <Menu DockPanel.Dock="Top" Padding="4,0" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="_File">
                    <MenuItem Header="Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Add File..." Command="{Binding AddFileCommand}" InputGestureText="Ctrl+Shift+O"/>
                    <MenuItem Header="Load Related Levels" Command="{Binding LoadRelatedLevelsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Save All" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem x:Name="Recents_MenuItem" Header="Recent" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}}" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Commit Changes" Command="{Binding CommitChangesCommand}" IsEnabled="{Binding IsDirty, Converter={StaticResource BoolEnabledConverter}}"/>
                    <MenuItem Header="Reset Uncommitted Changes..." Click="ResetUncommittedChanges_Click" IsEnabled="{Binding IsDirty}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Focus Selected Actor" Command="{Binding FocusSelectedCommand}" InputGestureText="F"/>
                    <MenuItem Header="Top Down" IsCheckable="True" IsChecked="{Binding IsOrthographicView}" InputGestureText="Numpad 5"/>
                    <MenuItem Header="Local Coordinates" IsCheckable="True" IsChecked="{Binding UseLocalCoordsForWidget}" InputGestureText="L"/>
                    <Separator/>
                    <MenuItem Header="Open Selected Actor in Package Editor" Command="{Binding OpenInPackageEditorCommand}"/>
                </MenuItem>
                <MenuItem Header="_Build" IsEnabled="{Binding CanEditScene}">
                    <MenuItem Header="Bake Lighting in Lightmass Baker..." Click="OpenInLightmassBaker_Click"
                              ToolTip="Opens the Lightmass Baker with the open files (read-only ones only cast shadows). It bakes the files as saved on disk."/>
                </MenuItem>
            </Menu>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding OpenFiles}" Margin="6,3,6,0" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Data.FocusFileCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}" ToolTip="{Binding FilePath}" Padding="12,6" Margin="0,0,3,0" Background="{StaticResource EditorPanel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Regular_File" Width="12" Margin="0,0,8,0" Foreground="{StaticResource EditorText}"/>
                                <TextBlock Text="{Binding FileName}"/>
                                <TextBlock Text=" •" Foreground="{StaticResource EditorDirty}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border DockPanel.Dock="Top" Background="{StaticResource EditorPanel}" Padding="6" Margin="0,0,0,4" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CommitChangesCommand}" IsEnabled="{Binding IsDirty, Converter={StaticResource BoolEnabledConverter}}" Style="{StaticResource CommitButton}" ToolTip="Apply editor transforms and light settings to the loaded packages. Use Save All to write them to disk.">
                        <StackPanel Orientation="Horizontal"><fa:ImageAwesome Icon="Solid_Check" Width="13" Margin="0,0,7,0" Foreground="{StaticResource EditorText}"/><TextBlock Text="Commit Changes"/></StackPanel>
                    </Button>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Command="{Binding OpenFileCommand}" ToolTip="Open a level (Ctrl+O)"><StackPanel Orientation="Horizontal"><fa:ImageAwesome Icon="Regular_FolderOpen" Width="14" Margin="0,0,7,0" Foreground="{StaticResource EditorText}"/><TextBlock Text="Open"/></StackPanel></Button>
                        <Button Command="{Binding SaveAllCommand}" ToolTip="Save all open packages (Ctrl+S)"><StackPanel Orientation="Horizontal"><fa:ImageAwesome Icon="Regular_Save" Width="14" Margin="0,0,7,0" Foreground="{StaticResource EditorText}"/><TextBlock Text="Save All"/></StackPanel></Button>
                        <Button x:Name="UndoMenuItem" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo, Converter={StaticResource BoolEnabledConverter}}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><fa:ImageAwesome Icon="Solid_Undo" Width="14" Foreground="{StaticResource EditorText}"/></Button>
                        <Button x:Name="RedoMenuItem" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo, Converter={StaticResource BoolEnabledConverter}}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><fa:ImageAwesome Icon="Solid_Redo" Width="14" Foreground="{StaticResource EditorText}"/></Button>
                        <Border Style="{StaticResource EditorToolbarSeparator}"/>
                        <Border Background="{StaticResource EditorInput}" CornerRadius="2" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="WidgetMode" Content="Move" Command="{Binding ToggleTranslateCommand}" IsChecked="True" ToolTip="Translate the selected actor"/>
                                <RadioButton GroupName="WidgetMode" Content="Rotate" Command="{Binding ToggleRotateCommand}"/>
                                <RadioButton GroupName="WidgetMode" Content="Scale" Command="{Binding ToggleScaleCommand}"/>
                                <RadioButton GroupName="WidgetMode" Content="Uniform" Command="{Binding ToggleUniformScaleCommand}" ToolTip="Scale uniformly"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorToolbarSeparator}"/>
                        <ToggleButton Content="Local" IsChecked="{Binding UseLocalCoordsForWidget}" ToolTip="Use local transform axes (L). Off uses world axes."/>
                        <xctk:DropDownButton Content="Transform settings" Style="{StaticResource EditorDropDownButton}" Margin="4,0,0,0"
                                             ToolTip="Snapping and numeric increments for all actors" AutomationProperties.Name="Transform settings">
                            <xctk:DropDownButton.DropDownContent>
                                <Border Width="340" Background="{StaticResource EditorPanel}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1"
                                        DataContext="{Binding Data, Source={StaticResource bindingProxy}}">
                                    <StackPanel>
                                        <Expander Header="Snapping" IsExpanded="True" Padding="10,7,10,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="37"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                                <CheckBox Content="Translation" IsChecked="{Binding TranslateSnapEnabled}"/>
                                                <xctk:SingleUpDown Grid.Column="1" Value="{Binding TranslateSnapValue}" Minimum="0.001" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Translation snap interval"/>
                                                <TextBlock Grid.Column="2" Text="units" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource EditorMuted}"/>
                                                <CheckBox Grid.Row="1" Content="Rotation" IsChecked="{Binding RotateSnapEnabled}"/>
                                                <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RotateSnapValue}" Minimum="0.1" Maximum="180" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Rotation snap interval"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="°" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource EditorMuted}"/>
                                                <CheckBox Grid.Row="2" Content="Scale" IsChecked="{Binding ScaleSnapEnabled}"/>
                                                <xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleSnapValue}" Minimum="0.01" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Scale snap interval"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource EditorMuted}"/>
                                            </Grid>
                                        </Expander>
                                        <Expander Header="Numeric increments" IsExpanded="True" Padding="10,7,10,10" ToolTip="Step used by the arrow keys in transform fields.">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                                <TextBlock Text="Position" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Column="1" Value="{Binding PosIncrement}" Minimum="0" FormatString="F3" AutomationProperties.Name="Position numeric increment"/>
                                                <TextBlock Grid.Row="1" Text="Rotation" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RotIncrement}" Minimum="0" FormatString="F2" AutomationProperties.Name="Rotation numeric increment"/>
                                                <TextBlock Grid.Row="2" Text="Scale" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleIncrement}" Minimum="0" FormatString="F3" AutomationProperties.Name="Scale numeric increment"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </xctk:DropDownButton.DropDownContent>
                        </xctk:DropDownButton>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="#351519" BorderBrush="#F05252" BorderThickness="0,0,0,2" Padding="20,16" Margin="0,0,0,4"
                    Visibility="{Binding IsBakePreview, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="BAKED LIGHTING PREVIEW" Foreground="#FF6464" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentModeName}" Foreground="{StaticResource EditorMuted}" Margin="12,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedActor.ActorName, TargetNullValue=''}" Foreground="#81B3DD" Margin="12,0"/>
                    <sharedToolControls:StatusBarGameIDIndicator DockPanel.Dock="Left" GameType="{Binding Game}" Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,-3,8,-3"/>
                    <TextBlock x:Name="StatusBar_LeftMostText" Text="Open a level package to begin" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid Margin="4,0,4,4">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="300"/><RowDefinition x:Name="ChangesSplitterRow" Height="5"/><RowDefinition x:Name="ChangesRow" Height="136" MinHeight="75"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="270"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition x:Name="DetailsSplitterColumn" Width="5"/><ColumnDefinition x:Name="DetailsColumn" Width="360" MinWidth="340"/></Grid.ColumnDefinitions>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TabControl Grid.Column="0" Style="{StaticResource EditorDockTabs}" ItemContainerStyle="{StaticResource EditorDockTab}">
                        <TabItem Header="World Outliner" IsSelected="True">
                            <DockPanel Background="{StaticResource EditorPanel}">
                                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
                                    <Button DockPanel.Dock="Right" Content="Collapse all" Click="CollapseOutlinerGroups_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Padding="5,4" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Collapse all outliner categories and level groups"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Group by" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource EditorMuted}"/>
                                        <RadioButton x:Name="GroupByLevelButton" GroupName="OutlinerGrouping" Content="Level" IsChecked="{Binding GroupActorsByLevel}" Padding="6,4" ToolTip="Group actors by their level package"/>
                                        <RadioButton x:Name="GroupByCategoryButton" GroupName="OutlinerGrouping" Content="Category" IsChecked="{Binding GroupActorsByCategory}" Padding="6,4" ToolTip="Group actors by category across all loaded levels"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <xctk:WatermarkTextBox x:Name="ActorFilter_TextBox" Watermark="Search actors" TextChanged="ActorFilter_TextBox_TextChanged" IsEnabled="{Binding HasAnyFileOpen}" AutomationProperties.Name="Search actors, tags, or export index" ToolTip="Search actors, tags, or #ID"/>
                                    <xctk:WatermarkTextBox x:Name="Goto_TextBox" Grid.Column="1" Watermark="#ID" Margin="5,0,0,0" KeyUp="Goto_TextBox_KeyUp" IsEnabled="{Binding HasAnyFileOpen}" AutomationProperties.Name="Export index" ToolTip="Export index"/>
                                    <Button Grid.Column="2" Content="Go to" Click="GotoButton_Clicked" IsEnabled="{Binding HasAnyFileOpen}" Padding="8,3" Margin="5,0,0,0"/>
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Actors.BindableCount, StringFormat='{}{0} actors loaded'}" Margin="9,7" Foreground="{StaticResource EditorMuted}" FontSize="11"/>
                                <ListBox x:Name="MeshExportsList" ItemsSource="{Binding ActorsView}" SelectedItem="{Binding SelectedActor}" ItemContainerStyle="{StaticResource ActorRow}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="GroupItem">
                                                                <Expander Style="{StaticResource OutlinerGroupExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                          Header="{TemplateBinding Content}" HeaderTemplate="{TemplateBinding ContentTemplate}">
                                                                    <Expander.DataContext>
                                                                        <MultiBinding Converter="{StaticResource OutlinerGroupStateConverter}" Mode="OneWay">
                                                                            <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                            <Binding Path="Data" Source="{StaticResource bindingProxy}"/>
                                                                        </MultiBinding>
                                                                    </Expander.DataContext>
                                                                    <ItemsPresenter/>
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource OutlinerCategoryHeader}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBottomLevel}" Value="True">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource OutlinerLevelHeader}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                                            <fa:ImageAwesome Width="12" HorizontalAlignment="Left">
                                                <fa:ImageAwesome.Style><Style TargetType="fa:ImageAwesome"><Setter Property="Icon" Value="Solid_Cube"/><Setter Property="Foreground" Value="#CDB374"/><Style.Triggers><DataTrigger Binding="{Binding Category}" Value="Lights"><Setter Property="Icon" Value="Solid_Lightbulb"/><Setter Property="Foreground" Value="#F0C04F"/></DataTrigger></Style.Triggers></Style></fa:ImageAwesome.Style>
                                            </fa:ImageAwesome>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IndexLabel}" Margin="8,0,0,0" FontSize="11" Opacity="0.8"/>
                                            <TextBlock Grid.Column="3" Text="•" Foreground="{StaticResource EditorDirty}" HorizontalAlignment="Right" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Uncommitted change"/>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Place Actors" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8" IsEnabled="{Binding HasAnyFileOpen}">
                                    <DockPanel>
                                        <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource EditorMuted}"/>
                                        <ComboBox ItemsSource="{Binding OpenFiles}" SelectedItem="{Binding PlacementFile}" DisplayMemberPath="FileName" ToolTip="The level new actors are placed in" AutomationProperties.Name="Level to place actors in"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PlacementOptions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Content="{Binding ClassName}" Command="{Binding Data.BeginPlacementCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}"
                                                    ToolTip="{Binding Description}" ToolTipService.ShowOnDisabled="True" Padding="8,3" Margin="0,0,5,5"/>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding PlacementStatus}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <DockPanel Grid.Column="2" Background="{StaticResource EditorPanel}">
                        <Border DockPanel.Dock="Top" Background="{StaticResource EditorChrome}"><Border Style="{StaticResource EditorDockTitle}"><TextBlock Text="Viewport" FontWeight="SemiBold"/></Border></Border>
                        <Border DockPanel.Dock="Top" Padding="5" Background="{StaticResource EditorPanel}" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding FocusSelectedCommand}" ToolTip="Focus the camera on the selected actor (F)" Padding="7,4" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><fa:ImageAwesome Icon="Solid_Expand" Width="12" Margin="0,0,6,0" Foreground="{StaticResource EditorText}"/><TextBlock Text="Focus Selected"/></StackPanel></Button>
                                <WrapPanel>
                                    <Menu Background="Transparent">
                                        <MenuItem x:Name="LightingMenu" Header="{Binding LightingMenuHeader}" Padding="7,4" ToolTip="Choose viewport lighting and isolate lightmaps or runtime lighting.">
                                            <MenuItem x:Name="LevelLightingMenuItem" Header="Level lighting" IsChecked="{Binding IsLevelLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Level}" StaysOpenOnClick="True" ToolTip="Use the level's lightmaps and runtime lighting. Unsupported materials use neutral lighting."/>
                                            <MenuItem x:Name="PreviewLightingMenuItem" Header="Preview lighting" IsChecked="{Binding IsPreviewLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Preview}" StaysOpenOnClick="True" ToolTip="Preview direct lighting and approximate shadows from the current level lights and geometry, without sampling existing lightmaps and shadowmaps. Eligibility follows the selected assignment policy. Does not include baked bounced lighting. Unsupported materials use neutral lighting."/>
                                            <MenuItem Header="Preview / bake assignments">
                                                <MenuItem Header="Preserve existing assignments" IsChecked="{Binding PreserveAssignments, Mode=OneWay}" Command="{Binding SetAssignmentPolicyCommand}" CommandParameter="{x:Static lightmass:LightAssignmentPolicy.PreserveExistingAssignments}" StaysOpenOnClick="True"/>
                                                <MenuItem Header="Recompute assignments" IsChecked="{Binding RecomputeAssignments, Mode=OneWay}" Command="{Binding SetAssignmentPolicyCommand}" CommandParameter="{x:Static lightmass:LightAssignmentPolicy.RecomputeAssignments}" StaysOpenOnClick="True"/>
                                            </MenuItem>
                                            <MenuItem x:Name="NeutralLightingMenuItem" Header="Neutral lighting" IsChecked="{Binding IsNeutralLighting, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Neutral}" StaysOpenOnClick="True" ToolTip="Use a neutral light to inspect materials and geometry, independent of the level's lights and lightmaps."/>
                                            <MenuItem x:Name="UnlitMenuItem" Header="Unlit" IsChecked="{Binding IsUnlit, Mode=OneWay}" Command="{Binding SetLightingModeCommand}" CommandParameter="{x:Static scene3D:ViewportLightingMode.Unlit}" StaysOpenOnClick="True" ToolTip="Show material colors without lighting."/>
                                            <Separator/>
                                            <MenuItem x:Name="DynamicLightingMenuItem" Header="Runtime lighting" IsCheckable="True" IsChecked="{Binding UseDynamicLighting}" IsEnabled="{Binding IsLevelLighting}" StaysOpenOnClick="True" ToolTip="Include lighting evaluated at runtime, including lights with precomputed shadowmaps. Lights baked into a lightmap remain part of that lightmap."/>
                                            <MenuItem x:Name="LightMapsMenuItem" Header="Lightmaps" IsCheckable="True" IsChecked="{Binding UseLightMaps}" IsEnabled="{Binding IsLevelLighting}" StaysOpenOnClick="True" ToolTip="Include baked texture and vertex lighting. Turn off Runtime lighting to view lightmaps alone."/>
                                        </MenuItem>
                                    </Menu>
                                    <ToggleButton Content="Top Down" IsChecked="{Binding IsOrthographicView}" Padding="7,4" ToolTip="Toggle top-down orthographic view (Numpad 5)"/>
                                    <Menu Background="Transparent">
                                        <MenuItem Header="Show ▾" Padding="7,4">
                                            <MenuItem Header="Collision" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding ShowCollision}"/>
                                            <MenuItem Header="Hidden Actors" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding ShowHidden}"/>
                                            <MenuItem Header="Selected Light's Reach" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding ShowLightReach}" ToolTip="Tint and outline the meshes the selected light is eligible to light"/>
                                        </MenuItem>
                                    </Menu>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <scene3D:SceneRenderControl x:Name="SceneViewer"/>
                            <Border Background="{StaticResource EditorInput}" Visibility="{Binding HasAnyFileOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="24" VerticalAlignment="Center" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Level Editor" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock Text="Open a level package or drop one here to start editing." Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <Button Content="Open Level…" Command="{Binding OpenFileCommand}" HorizontalAlignment="Left" Background="{StaticResource EditorAccent}" Padding="16,8"/>
                                        <TextBlock Text="Recent level sets" Margin="0,24,0,8" FontWeight="SemiBold" Visibility="{Binding RecentSets.Any, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding RecentSets}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Command="{Binding Data.OpenRecentSetCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}" ToolTip="{Binding TooltipText}" HorizontalContentAlignment="Left" Margin="0,2" Padding="7">
                                                <DockPanel><Image DockPanel.Dock="Left" Source="{Binding Game, Converter={StaticResource GameToImageIconConverter}}" Height="16" Width="16" Margin="0,0,8,0"/><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></DockPanel>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <TextBlock Margin="0,24,0,0" Foreground="{StaticResource EditorMuted}" TextWrapping="Wrap">Some actor types cannot be displayed. See rendering notes below after loading a level.</TextBlock>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"><Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.ME3TweaksDiscordInviteURL), Mode=OneTime}" Foreground="#81B3DD" misc:HyperlinkExtensions.IsExternal="True">ME3Tweaks Discord</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="{Binding Path=(misc:AppLinks.BugReportURL), Mode=OneTime}" Foreground="#81B3DD" misc:HyperlinkExtensions.IsExternal="True">Report an issue</Hyperlink></TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <DockPanel Grid.Column="4" Background="{StaticResource EditorPanel}" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border DockPanel.Dock="Top" Background="{StaticResource EditorChrome}"><Border Style="{StaticResource EditorDockTitle}"><TextBlock Text="Details" FontWeight="SemiBold"/></Border></Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel Margin="10,10,10,12">
                                    <Border Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" Padding="8,6" CornerRadius="2"><TextBlock Text="{Binding SelectedActor.ActorName, TargetNullValue='Select an actor'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Border>
                                    <TextBlock Text="{Binding SelectedActor.DisplayText}" Foreground="#81B3DD" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedActor.ExportLabel}" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding SelectedActor.CoverageLabel}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding SelectedActor.CoverageReason}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="0,3,0,0"/>
                                    <TextBlock Text="Read-only package" Foreground="{StaticResource EditorDirty}" Margin="0,6,0,0" Visibility="{Binding SelectedActor.OwningFile.IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                </StackPanel>
                                <Expander Header="Transform" IsExpanded="True" Padding="10,0,10,10" Visibility="{Binding SelectedActor.HasSpatialRepresentation, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <StackPanel DataContext="{Binding SelectedActor}">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding CanEditTransform}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding OwningFile.IsReadOnly}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="Position · world units" Style="{StaticResource EditorSectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <DockPanel><TextBlock Text="X" Background="{StaticResource EditorX}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="xPosUpDown" Value="{Binding XPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Position X"/></DockPanel>
                                            <DockPanel Grid.Column="2"><TextBlock Text="Y" Background="{StaticResource EditorY}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="yPosUpDown" Value="{Binding YPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Position Y"/></DockPanel>
                                            <DockPanel Grid.Column="4"><TextBlock Text="Z" Background="{StaticResource EditorZ}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="zPosUpDown" Value="{Binding ZPos}" Increment="{Binding PosIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Position Z"/></DockPanel>
                                        </Grid>
                                        <TextBlock Text="Rotation · degrees" Style="{StaticResource EditorSectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <DockPanel ToolTip="Roll (X)"><TextBlock Text="X" Background="{StaticResource EditorX}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="rollUpDown" Value="{Binding RollDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F2" AutomationProperties.Name="Roll degrees"/></DockPanel>
                                            <DockPanel Grid.Column="2" ToolTip="Pitch (Y)"><TextBlock Text="Y" Background="{StaticResource EditorY}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="pitchUpDown" Value="{Binding PitchDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F2" AutomationProperties.Name="Pitch degrees"/></DockPanel>
                                            <DockPanel Grid.Column="4" ToolTip="Yaw (Z)"><TextBlock Text="Z" Background="{StaticResource EditorZ}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="yawUpDown" Value="{Binding YawDegrees}" Increment="{Binding RotIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F2" AutomationProperties.Name="Yaw degrees"/></DockPanel>
                                        </Grid>
                                        <TextBlock Text="Scale · per axis" Style="{StaticResource EditorSectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <DockPanel><TextBlock Text="X" Background="{StaticResource EditorX}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="xScaleUpDown" Value="{Binding XScale}" Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Scale X"/></DockPanel>
                                            <DockPanel Grid.Column="2"><TextBlock Text="Y" Background="{StaticResource EditorY}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="yScaleUpDown" Value="{Binding YScale}" Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Scale Y"/></DockPanel>
                                            <DockPanel Grid.Column="4"><TextBlock Text="Z" Background="{StaticResource EditorZ}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown x:Name="zScaleUpDown" Value="{Binding ZScale}" Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Scale Z"/></DockPanel>
                                        </Grid>
                                        <DockPanel Margin="0,10,0,0"><TextBlock Text="Uniform scale" VerticalAlignment="Center"/><xctk:SingleUpDown x:Name="scaleUpDown" Width="108" HorizontalAlignment="Right" Value="{Binding DrawScale}" Increment="{Binding ScaleIncrement, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" FormatString="F3" AutomationProperties.Name="Uniform scale"/></DockPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Decal projection" IsExpanded="True" Padding="10,0,10,10" Visibility="{Binding IsDecalSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedActor.DecalEditingStatus}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="0,6,0,8"/>
                                        <Grid DataContext="{Binding SelectedDecal}" IsEnabled="{Binding IsEditable}">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Width" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Column="1" Value="{Binding Width}" Minimum="0.01" Increment="10" FormatString="F2"/>
                                            <TextBlock Grid.Row="1" Text="Height" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Height}" Minimum="0.01" Increment="10" FormatString="F2"/>
                                            <TextBlock Grid.Row="2" Text="Near plane" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding NearPlane}" Minimum="0" Increment="10" FormatString="F2"/>
                                            <TextBlock Grid.Row="3" Text="Far plane" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="3" Grid.Column="1" Value="{Binding FarPlane}" Increment="10" FormatString="F2"/>
                                            <TextBlock Grid.Row="4" Text="Decal rotation · degrees" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Rotation}" Increment="1" FormatString="F2"/>
                                            <TextBlock Grid.Row="5" Text="Tile X" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="5" Grid.Column="1" Value="{Binding TileX}" Increment="0.1" FormatString="F3"/>
                                            <TextBlock Grid.Row="6" Text="Tile Y" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="6" Grid.Column="1" Value="{Binding TileY}" Increment="0.1" FormatString="F3"/>
                                            <TextBlock Grid.Row="7" Text="Offset X" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="7" Grid.Column="1" Value="{Binding OffsetX}" Increment="0.05" FormatString="F3"/>
                                            <TextBlock Grid.Row="8" Text="Offset Y" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="8" Grid.Column="1" Value="{Binding OffsetY}" Increment="0.05" FormatString="F3"/>
                                            <TextBlock Grid.Row="9" Text="Depth bias" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="9" Grid.Column="1" Value="{Binding DepthBias}" Increment="0.00001" FormatString="F6"/>
                                            <TextBlock Grid.Row="10" Text="Sort order" VerticalAlignment="Center"/><xctk:IntegerUpDown Grid.Row="10" Grid.Column="1" Value="{Binding SortOrder}"/>
                                        </Grid>
                                        <StackPanel DataContext="{Binding SelectedDecal}" Margin="0,10,0,0">
                                            <TextBlock Text="DecalMaterial" Style="{StaticResource EditorSectionLabel}"/>
                                            <TextBlock Text="{Binding MaterialName}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MaterialProblem}" Visibility="{Binding MaterialProblem, Converter={StaticResource NullVisibilityConverter}}"
                                                       TextWrapping="Wrap" Foreground="#FF6464" FontSize="11" Margin="0,4,0,0"
                                                       ToolTip="The game draws the engine's DefaultDecalMaterial in its place, as the preview does."/>
                                            <Button Content="Choose material…" Click="DecalMaterial_Click" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    ToolTip="Only materials the game can draw on a decal: a DecalMaterial, or one whose base material is marked bUsedWithDecals."/>
                                        </StackPanel>
                                        <StackPanel DataContext="{Binding SelectedDecal}" IsEnabled="{Binding IsEditable}" Margin="0,10,0,0">
                                            <TextBlock Text="Receiving meshes" Style="{StaticResource EditorSectionLabel}"/>
                                            <ComboBox ItemsSource="{x:Static local:EditableDecal.FilterModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding FilterMode}" AutomationProperties.Name="Decal filter mode" ToolTip="FilterMode: all meshes, only actors in Filter, or all actors except those in Filter."/>
                                            <TextBlock Text="{Binding FilterSummary}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,6,0,4"/>
                                            <TextBlock Text="Search actors or packages" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,2,0,3"/>
                                            <TextBox Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search decal receiving meshes" ToolTip="Search loaded mesh actors by name or package" Margin="0,0,0,4"/>
                                            <ListBox ItemsSource="{Binding FilterCandidates}" MaxHeight="210" Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3" ToolTip="{Binding Path}" HorizontalContentAlignment="Stretch">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource EditorMuted}" FontSize="10" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="Refresh list" Click="RefreshDecalFilter_Click" Margin="0,0,6,0"/>
                                                <Button Content="Clear checked" Click="ClearDecalFilter_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Spline point" IsExpanded="True" Padding="10,0,10,10" Visibility="{Binding IsSplineSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <DataTemplate x:Key="SplineConnectionTemplate">
                                                <StackPanel Margin="0,4,0,6" IsEnabled="{Binding IsEditable}">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                    <WrapPanel>
                                                        <Button Content="Break" Tag="Break" Click="SplineConnection_Click" Margin="0,3,4,0"/>
                                                        <Button Content="Reverse" Tag="Reverse" IsEnabled="{Binding CanReverse}" Click="SplineConnection_Click" Margin="0,3,4,0"/>
                                                        <Button Content="Straight tangents" Tag="Straight" Click="SplineConnection_Click" Margin="0,3,0,0"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </StackPanel.Resources>
                                        <TextBlock Text="{Binding SelectedSpline.EditingStatus}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="0,6,0,8"/>
                                        <TextBlock Text="Ctrl+click a spline point or mesh to connect or flip. Ctrl+Shift+click breaks." TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}"/>
                                        <TextBlock Text="Connections must join the same point type. Loft start points need a DeformMesh." TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}"/>
                                        <StackPanel IsEnabled="{Binding SelectedSpline.Point.IsEditable}">
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="Break all" Click="SplineBreakAll_Click" Margin="0,0,4,0"/>
                                                <Button Content="Reverse whole spline" Click="SplineReverseAll_Click"/>
                                            </WrapPanel>
                                            <TextBlock Text="Outgoing connections" Style="{StaticResource EditorSectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding SelectedSpline.OutgoingConnections}" ItemTemplate="{StaticResource SplineConnectionTemplate}"/>
                                            <TextBlock Text="Incoming connections" Style="{StaticResource EditorSectionLabel}"/>
                                            <ItemsControl ItemsSource="{Binding SelectedSpline.IncomingConnections}" ItemTemplate="{StaticResource SplineConnectionTemplate}"/>
                                            <StackPanel Visibility="{Binding SelectedSpline.IsLoft, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="DeformMesh" Style="{StaticResource EditorSectionLabel}"/>
                                                <TextBlock Text="{Binding SelectedSpline.DeformMeshName}" TextWrapping="Wrap"/>
                                                <WrapPanel><Button Content="Choose mesh…" Click="SplineMesh_Click" Margin="0,4,4,0"/><Button Content="Clear" IsEnabled="{Binding SelectedSpline.CanClearDeformMesh}" Click="SplineClearMesh_Click" Margin="0,4,0,0" ToolTip="Break outgoing connections before clearing the mesh."/></WrapPanel>
                                                <TextBlock Text="DeformMeshMaterials · slot order" Style="{StaticResource EditorSectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding SelectedSpline.MaterialSlots}">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <StackPanel Margin="0,3,0,4">
                                                            <TextBlock Text="{Binding Index, StringFormat='Slot {0}'}"/>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}"/>
                                                            <WrapPanel>
                                                                <Button Content="Choose…" Tag="Choose" Click="SplineMaterialSlot_Click" Margin="0,3,4,0"/>
                                                                <Button Content="Use mesh material" Tag="Clear" Click="SplineMaterialSlot_Click" Margin="0,3,4,0"/>
                                                                <Button Content="Remove slot" Tag="Remove" Click="SplineMaterialSlot_Click" Margin="0,3,0,0"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <WrapPanel><Button Content="Add override…" Click="SplineMaterials_Click" Margin="0,4,4,0"/><Button Content="Clear overrides" Click="SplineClearMaterials_Click" Margin="0,4,0,0"/></WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel DataContext="{Binding SelectedSpline.Point}" IsEnabled="{Binding IsEditable}">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                                <TextBlock Text="Tangent length" VerticalAlignment="Center" ToolTip="The curves' strength at this point, in world units. The arrow grabbers in the viewport drag it"/><xctk:SingleUpDown Grid.Column="1" Value="{Binding TangentLength}" Minimum="0" Increment="50" FormatString="F2" AutomationProperties.Name="Tangent length"/>
                                                <TextBlock Grid.Row="1" Text="Tangent yaw · degrees" VerticalAlignment="Center" ToolTip="The curves' world heading at this point. The sphere grabbers in the viewport turn it"/><xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TangentYaw}" Increment="5" FormatString="F2" AutomationProperties.Name="Tangent yaw"/>
                                                <TextBlock Grid.Row="2" Text="Tangent pitch · degrees" VerticalAlignment="Center" ToolTip="The curves' world elevation at this point, from -90 (down) to 90 (up)"/><xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TangentPitch}" Minimum="-90" Maximum="90" Increment="5" FormatString="F2" AutomationProperties.Name="Tangent pitch"/>
                                            </Grid>
                                            <TextBlock Text="Tangent · actor space" Style="{StaticResource EditorSectionLabel}" ToolTip="SplineActorTangent: the curves' direction and strength at this point, in the point's own space"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <DockPanel><TextBlock Text="X" Background="{StaticResource EditorX}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding TangentX}" Increment="50" FormatString="F2" AutomationProperties.Name="Tangent X"/></DockPanel>
                                                <DockPanel Grid.Column="2"><TextBlock Text="Y" Background="{StaticResource EditorY}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding TangentY}" Increment="50" FormatString="F2" AutomationProperties.Name="Tangent Y"/></DockPanel>
                                                <DockPanel Grid.Column="4"><TextBlock Text="Z" Background="{StaticResource EditorZ}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding TangentZ}" Increment="50" FormatString="F2" AutomationProperties.Name="Tangent Z"/></DockPanel>
                                            </Grid>
                                            <StackPanel Visibility="{Binding IsLoft, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Mesh X axis · world direction" Style="{StaticResource EditorSectionLabel}" ToolTip="WorldXDir: the direction the deformed mesh's X axis is turned towards along the connections leaving this point"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <DockPanel><TextBlock Text="X" Background="{StaticResource EditorX}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding WorldXDirX}" Increment="0.1" FormatString="F3" AutomationProperties.Name="WorldXDir X"/></DockPanel>
                                                    <DockPanel Grid.Column="2"><TextBlock Text="Y" Background="{StaticResource EditorY}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding WorldXDirY}" Increment="0.1" FormatString="F3" AutomationProperties.Name="WorldXDir Y"/></DockPanel>
                                                    <DockPanel Grid.Column="4"><TextBlock Text="Z" Background="{StaticResource EditorZ}" Style="{StaticResource EditorAxisLabel}"/><xctk:SingleUpDown Value="{Binding WorldXDirZ}" Increment="0.1" FormatString="F3" AutomationProperties.Name="WorldXDir Z"/></DockPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                                    <TextBlock Text="Roll · degrees" VerticalAlignment="Center" ToolTip="Roll of the mesh around the spline at this point"/><xctk:SingleUpDown Grid.Column="1" Value="{Binding Roll}" Increment="5" FormatString="F2"/>
                                                    <TextBlock Grid.Row="1" Text="Scale X" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ScaleX}" Increment="0.1" FormatString="F3"/>
                                                    <TextBlock Grid.Row="2" Text="Scale Y" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScaleY}" Increment="0.1" FormatString="F3"/>
                                                    <TextBlock Grid.Row="3" Text="Offset X" VerticalAlignment="Center" ToolTip="Offset of the mesh from the spline, applied before scale and roll"/><xctk:SingleUpDown Grid.Row="3" Grid.Column="1" Value="{Binding OffsetX}" Increment="10" FormatString="F2"/>
                                                    <TextBlock Grid.Row="4" Text="Offset Y" VerticalAlignment="Center"/><xctk:SingleUpDown Grid.Row="4" Grid.Column="1" Value="{Binding OffsetY}" Increment="10" FormatString="F2"/>
                                                </Grid>
                                                <CheckBox Content="Smooth roll and scale" IsChecked="{Binding SmoothInterpRollAndScale}" Margin="0,6,0,0" ToolTip="bSmoothInterpRollAndScale: ease roll, scale and offset along the connections leaving this point, instead of changing them linearly"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Light" IsExpanded="True" Padding="10,0,10,10" Visibility="{Binding IsLightSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                    <StackPanel DataContext="{Binding SelectedLight}">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding SelectedActor.OwningFile.IsReadOnly, RelativeSource={RelativeSource AncestorType=local:LevelEditor}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="Uncommitted" Foreground="{StaticResource EditorDirty}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" ToolTip="bEnabled. A disabled light lights nothing."/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TypeName}" Foreground="#81B3DD" FontSize="11" Margin="0,4,0,0"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                            <TextBlock Text="Brightness" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Grid.Column="1" Value="{Binding Brightness}" Increment="0.1" FormatString="F3" VerticalAlignment="Center" AutomationProperties.Name="Light brightness"/>
                                            <TextBlock Grid.Row="1" Text="Color" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker Grid.Row="1" Grid.Column="1" SelectedColor="{Binding Color}" UsingAlphaChannel="False" ShowDropDownButton="True" VerticalAlignment="Center" AutomationProperties.Name="Light color"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasRadius, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                            <TextBlock Text="Radius" VerticalAlignment="Center" ToolTip="Drag the white handle in the viewport to change it there."/>
                                            <xctk:SingleUpDown Grid.Column="1" Value="{Binding Radius}" Increment="16" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Light radius"/>
                                            <TextBlock Grid.Row="1" Text="Falloff exponent" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FalloffExponent}" Increment="0.1" FormatString="F2" VerticalAlignment="Center" AutomationProperties.Name="Light falloff exponent"/>
                                        </Grid>
                                        <Grid Visibility="{Binding IsSpot, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                            <TextBlock Text="Inner cone · degrees" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Grid.Column="1" Value="{Binding InnerConeAngle}" Increment="1" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Spot light inner cone angle"/>
                                            <TextBlock Grid.Row="1" Text="Outer cone · degrees" VerticalAlignment="Center"/>
                                            <xctk:SingleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OuterConeAngle}" Increment="1" FormatString="F1" VerticalAlignment="Center" AutomationProperties.Name="Spot light outer cone angle"/>
                                        </Grid>
                                        <TextBlock Text="Shadows" Style="{StaticResource EditorSectionLabel}"/>
                                        <WrapPanel>
                                            <CheckBox Content="Cast shadows" IsChecked="{Binding CastShadows}" Margin="0,0,12,4" ToolTip="CastShadows: whether the light casts any shadows"/>
                                            <CheckBox Content="Static" IsChecked="{Binding CastStaticShadows}" Margin="0,0,12,4" ToolTip="CastStaticShadows: precomputed shadows, and light environments' visibility tests"/>
                                            <CheckBox Content="Dynamic" IsChecked="{Binding CastDynamicShadows}" Margin="0,0,12,4" ToolTip="CastDynamicShadows: shadows rendered at runtime"/>
                                        </WrapPanel>
                                        <TextBlock Text="Lighting channels" Style="{StaticResource EditorSectionLabel}"/>
                                        <ItemsControl ItemsSource="{Binding Channels}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Width="108" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                        <CheckBox Content="Highlight meshes in reach" IsChecked="{Binding ShowLightReach}" Margin="0,10,0,0" ToolTip="Tint and outline the meshes the selected light is eligible to light"/>
                                        <TextBlock Text="{Binding SelectedLightReach}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding LightingRulesNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Lighting" IsExpanded="True" Padding="10,4,10,10" Visibility="{Binding IsMeshSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SelectedActorLighting}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <TextBlock Text="{Binding ActorPropertyName}" FontWeight="SemiBold" Foreground="#81B3DD" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding ComponentName, StringFormat='Export: {0}'}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding MeshName, StringFormat='Mesh: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Uncommitted" Foreground="{StaticResource EditorDirty}" FontSize="11" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="Light environment" Style="{StaticResource EditorSectionLabel}"/>
                                                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" DisplayMemberPath="Name" ToolTip="Choose a LightEnvironment owned by this actor or its archetype, or None for direct lighting. Commit to apply the assignment." AutomationProperties.Name="Light environment">
                                                        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsSelectable}"/></Style></ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Content="Edit properties…" Click="EditLightEnvironment_Click" IsEnabled="{Binding CanEditEnvironment}" Margin="0,0,4,4" ToolTip="Edit this actor's own LightEnvironment component."/>
                                                        <Button Content="New dynamic" Click="CreateLightEnvironment_Click" Tag="Dynamic" IsEnabled="{Binding CanCreateEnvironment}" Margin="0,0,4,4" ToolTip="Create and assign a DynamicLightEnvironmentComponent owned by this actor."/>
                                                        <Button Content="New Bio" Click="CreateLightEnvironment_Click" Tag="Bio" IsEnabled="{Binding CanCreateEnvironment}" Margin="0,0,0,4" ToolTip="Create and assign a BioDynamicLightEnvironmentComponent owned by this actor."/>
                                                    </WrapPanel>
                                                    <TextBlock Text="Assignments use Commit and Undo. New components and property edits change the package immediately; save the package to keep them. Inherited or imported environments need a local component to edit." TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11"/>
                                                    <TextBlock Text="Lighting channels" Style="{StaticResource EditorSectionLabel}"/>
                                                    <ItemsControl ItemsSource="{Binding Channels}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Width="108" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="Light reception" Style="{StaticResource EditorSectionLabel}"/>
                                                    <CheckBox Content="Accept lights" IsChecked="{Binding AcceptsLights}" Margin="0,0,0,4" ToolTip="bAcceptsLights: receive direct level lighting."/>
                                                    <CheckBox Content="Accept dynamic lights" IsChecked="{Binding AcceptsDynamicLights}" Margin="0,0,0,4" ToolTip="bAcceptsDynamicLights: receive dynamic lights when using direct level lighting."/>
                                                    <TextBlock Text="Shadows" Style="{StaticResource EditorSectionLabel}"/>
                                                    <CheckBox Content="Cast shadows" IsChecked="{Binding CastShadow}" Margin="0,0,0,4" ToolTip="CastShadow: whether this component casts shadows."/>
                                                    <CheckBox Content="Cast dynamic shadows" IsChecked="{Binding CastDynamicShadow}" Margin="0,0,0,4" ToolTip="bCastDynamicShadow: cast shadows at runtime."/>
                                                    <CheckBox Content="Use precomputed shadows" IsChecked="{Binding UsePrecomputedShadows}" Margin="0,0,0,4" ToolTip="bUsePrecomputedShadows: use static shadowing. Changing this does not rebuild baked lighting."/>
                                                </StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Eligibility follows the selected assignment policy in Preview mode. An eligible light can still be blocked; bake mappings and runtime routing are separate." TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding LightingRulesNote}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="0,4,0,0"/>
                                        <ItemsControl ItemsSource="{Binding SelectedMeshNotes}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource EditorDirty}" FontSize="11" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No level light reaches this Actor." Foreground="{StaticResource EditorMuted}" Margin="0,8,0,0" Visibility="{Binding SelectedMeshLights.Any, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedMeshLights}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Command="{Binding Data.SelectLightCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding LightActor}" HorizontalContentAlignment="Stretch" Padding="4,3" Margin="0,1" ToolTip="Select this light">
                                                    <DockPanel>
                                                        <fa:ImageAwesome DockPanel.Dock="Left" Icon="Solid_Lightbulb" Width="10" Margin="0,2,7,0" VerticalAlignment="Top">
                                                            <fa:ImageAwesome.Style><Style TargetType="fa:ImageAwesome"><Setter Property="Foreground" Value="{StaticResource EditorMuted}"/><Style.Triggers><DataTrigger Binding="{Binding IsAffecting}" Value="True"><Setter Property="Foreground" Value="#F09E1F"/></DataTrigger></Style.Triggers></Style></fa:ImageAwesome.Style>
                                                        </fa:ImageAwesome>
                                                        <StackPanel>
                                                            <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding LightName, Mode=OneWay}"/><Run Text="{Binding LevelName, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{StaticResource EditorMuted}"/></TextBlock>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource EditorDirty}"/><Style.Triggers><DataTrigger Binding="{Binding IsAffecting}" Value="True"><Setter Property="Foreground" Value="{StaticResource EditorMuted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <DockPanel Grid.Row="2" Background="{StaticResource EditorPanel}" Visibility="{Binding CanEditScene, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel DockPanel.Dock="Top" Background="{StaticResource EditorChrome}">
                        <Button DockPanel.Dock="Right" Command="{Binding SaveAllCommand}" Content="Save All" Padding="10,5"/>
                        <Button DockPanel.Dock="Right" Command="{Binding CommitChangesCommand}" IsEnabled="{Binding IsDirty, Converter={StaticResource BoolEnabledConverter}}" Content="Commit Changes" Padding="10,5" Style="{StaticResource CommitButton}"/>
                        <Border Style="{StaticResource EditorDockTitle}"><StackPanel Orientation="Horizontal"><TextBlock Text="Changes" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingChangeCount, StringFormat=' ({0})'}" Foreground="{StaticResource EditorMuted}"/></StackPanel></Border>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Commit writes every change, new actor and deletion to the loaded packages. Save writes packages to disk." Foreground="{StaticResource EditorMuted}" FontSize="11" Margin="10,6,10,3"/>
                    <Expander DockPanel.Dock="Bottom" Header="Rendering notes" IsExpanded="False" Margin="0" Padding="10,4">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TextBelowActors}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding TextBelowActors}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding TextBelowActors}" TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" FontSize="11"/></ScrollViewer>
                    </Expander>
                    <Grid>
                        <TextBlock Text="No uncommitted changes." Foreground="{StaticResource EditorMuted}" Margin="10,6" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Not}"/>
                        <ListBox ItemsSource="{Binding PendingChanges}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Button Command="{Binding Data.SelectChangedActorCommand, Source={StaticResource bindingProxy}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="3,0" ToolTip="{Binding PendingChangeStatus}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ChangeKind}" Foreground="{StaticResource EditorDirty}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ActorName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OwningFileName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource EditorMuted}"/>
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Foreground="{StaticResource EditorMuted}"><Run Text="X "/><Run Text="{Binding XPos, StringFormat=F1}"/><Run Text="  Y "/><Run Text="{Binding YPos, StringFormat=F1}"/><Run Text="  Z "/><Run Text="{Binding ZPos, StringFormat=F1}"/></TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</misc:NotifyPropertyChangedWindowBase>
