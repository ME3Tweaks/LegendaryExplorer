<UserControl x:Class="LegendaryExplorer.Tools.AssetDatabase.AssetUsagesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.com/icons/"
             xmlns:assetDatabase="clr-namespace:LegendaryExplorer.Tools.AssetDatabase"
             xmlns:controls="clr-namespace:LegendaryExplorer.SharedUI.Controls"
             x:Name="usagesPanel">
    <UserControl.Resources>
        <assetDatabase:FileIndexToNameConverter x:Key="FileIndexToNameConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding HeaderText, ElementName=usagesPanel}" Background="{DynamicResource Theme.Background.InfoBar}" Foreground="{DynamicResource Theme.Foreground.Primary}" HorizontalAlignment="Stretch" Padding="3"
                   ToolTip="{Binding HeaderToolTip, ElementName=usagesPanel}" Grid.Row="0"/>
        <Button ToolTip="Copies the list of usages to the clipboard as text" Click="CopyButton_Click"
                VerticalAlignment="Center" Padding="3" HorizontalAlignment="Right" Width="26" Grid.Row="0">
            <fa:ImageAwesome Icon="Solid_Copy" Foreground="CornflowerBlue"/>
        </Button>
        <controls:ListBoxScroll x:Name="internalListBox" MinWidth="200"
                                ItemsSource="{Binding UsagesSource, ElementName=usagesPanel}"
                                Grid.Row="1">
            <controls:ListBoxScroll.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FileIndexToNameConverter}">
                                <Binding Path="FileKey"/>
                                <Binding Path="FileListExtended" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"/>
                                <Binding Path="UIndex"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </controls:ListBoxScroll.ItemTemplate>
            <controls:ListBoxScroll.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Background.ControlHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Background.Selected}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsInDLC}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.Background.InfoBar}"/>
                            <Setter Property="TextElement.ToolTip" Value="DLC content"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsInMod}" Value="True">
                            <Setter Property="Foreground" Value="IndianRed"/>
                            <Setter Property="TextElement.ToolTip" Value="Mod - file from a mod DLC directory"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ListBoxScroll.ItemContainerStyle>
        </controls:ListBoxScroll>
    </Grid>
</UserControl>
