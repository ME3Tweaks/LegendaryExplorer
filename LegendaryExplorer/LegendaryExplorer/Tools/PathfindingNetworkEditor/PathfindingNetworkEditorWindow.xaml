<bases:TrackingNotifyPropertyChangedWindowBase
  xmlns:bases="clr-namespace:LegendaryExplorer.SharedUI.Bases"
        x:Class="LegendaryExplorer.Tools.PathfindingNetworkEditor.PathfindingNetworkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sharedUi="clr-namespace:LegendaryExplorer.SharedUI"
        xmlns:controls="clr-namespace:LegendaryExplorer.Tools.PathfindingNetworkEditor.Controls" 
        xmlns:converters="clr-namespace:LegendaryExplorer.SharedUI.Converters"
        xmlns:sharedToolControls="clr-namespace:LegendaryExplorer.UserControls.SharedToolControls" xmlns:exportloadercontrols="clr-namespace:LegendaryExplorer.UserControls.ExportLoaderControls" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Pathfinding Network Editor" Height="450" Width="800">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullEnabledConverter x:Key="NullEnabledConverter"/>
        <converters:IsIntEqualConverter x:Key="IsIntEqualConverter"/>
        <converters:IsIntNotEqualVisibilityConverter x:Key="IsIntNotEqualVisibilityConverter"/>
        <converters:IsIntEqualVisibilityConverter x:Key="IsIntEqualVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:EZFilteringActiveConverter x:Key="EZFilteringActiveConverter"/>
        <converters:GameTypeConverter x:Key="GameTypeConverter"/>
        <ContextMenu x:Key="nodeContextMenu" >
            <MenuItem Header="Create Connection to new SplineActor" Command="{Binding AddNewSplineActorToChainCommand}" sharedUi:Bindings.VisibilityToEnabled="True"/>
            <MenuItem Header="Remove from level" Command="{Binding RemoveFromLevelCommand}" ToolTip="Removes this object from the level"/>
            <MenuItem Header="Trash and Remove from level" Command="{Binding TrashAndRemoveFromLevelCommand}" ToolTip="Removes this object from the level and Trashes it"/>
            <MenuItem Header="Add to group" Command="{Binding AddToGroupCommand}" ToolTip="Add this object to the actor group" Visibility="{Binding ShowArtTools, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <MenuItem Header="Remove from group" Command="{Binding RemoveFromGroupCommand}" CommandParameter="graph" ToolTip="Removes this object from the group" Visibility="{Binding ShowArtTools, Converter={StaticResource BoolToVisibilityConverter}}"/>

        </ContextMenu>
    </Window.Resources>
    <xctk:BusyIndicator IsBusy="{Binding Path=IsBusy}" BusyContent="{Binding BusyText}">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File" Padding="4">
                    <MenuItem Header="_Open" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"
                  ToolTip="Open level master package" />
                    <!-- <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"
                  ToolTip="Save package file in-place"
                  IsEnabled="{Binding Pcc, Converter={StaticResource NullEnabledConverter}}" />
                <MenuItem Header="Save as" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"
                  ToolTip="Save package file to another location"
                  IsEnabled="{Binding Pcc, Converter={StaticResource NullEnabledConverter}}" /> -->
                    <Separator />
                    <MenuItem Name="Recents_MenuItem" Header="Recent" IsEnabled="false" />
                </MenuItem>
                <MenuItem Header="Levels" ItemsSource="{Binding PackageHandler.OpenLevelsList}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding UILevelName}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsEnabled}" />
                            <Setter Property="StaysOpenOnClick" Value="True" />
                            <Setter Property="Command" Value="{Binding DataContext.ToggleLevelCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Cover">
                    <MenuItem Header="Show Firelinks" IsCheckable="True" IsChecked="{Binding ShowFirelinks}" StaysOpenOnClick="True"/>
                    <MenuItem Header="Show Danger Navs" IsCheckable="True" IsChecked="{Binding ShowDangerNavs}" StaysOpenOnClick="True"/>
                    <MenuItem Header="Show Exposed Cover" IsCheckable="True" IsChecked="{Binding ShowExposedCover}" StaysOpenOnClick="True"/>
                </MenuItem>
                <MenuItem Header="Network">
                    <MenuItem Header="Show Rotation" IsCheckable="True" IsChecked="{Binding ShowRotation}" StaysOpenOnClick="True" ToolTip="Draw a rotation arrow on each node when zoomed in past the configured threshold"/>
                    <MenuItem Header="Follow camera" IsCheckable="True" IsChecked="{Binding FollowCamera}" StaysOpenOnClick="True" ToolTip="Pans the map automatically to keep the camera on the map"/>
                    <MenuItem Header="Load tiles" ToolTip="Loads background tiles from a folder" Command="{Binding LoadTilesCommand}"/>
                </MenuItem>
            </Menu>




            <!-- Bottom statusbar -->
            <StatusBar Height="23" DockPanel.Dock="Bottom">
                <sharedToolControls:StatusBarGameIDIndicator
                    Visibility="{Binding PackageHandler.OpenLevelsList.BindableCount, Converter={StaticResource IsIntNotEqualVisibilityConverter}, ConverterParameter=0}"
                    GameType="{Binding PackageHandler.Game}" Margin="0,-4" />
                <StatusBarItem>
                    <TextBlock Name="StatusBar_LeftMostText" Text="{Binding PackageHandler.MasterLevelName}" />
                </StatusBarItem>
                <StatusBarItem HorizontalContentAlignment="Right" HorizontalAlignment="Right">
                    <TextBlock Name="StatusBar_Coordinates" />
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <sharedToolControls:RecentsControl x:Name="Recents_Control" Visibility="{Binding PackageHandler.OpenLevelsList.BindableCount, Converter={StaticResource IsIntEqualVisibilityConverter}, ConverterParameter=0}"/>
                <DockPanel Visibility="{Binding PackageHandler.OpenLevelsList.BindableCount, Converter={StaticResource IsIntNotEqualVisibilityConverter}, ConverterParameter=0}">
                    <!-- Left side controls panel. -->
                    <Expander DockPanel.Dock="Left" ExpandDirection="Right" IsExpanded="False" Background="CornflowerBlue" sharedUi:Bindings.VisibilityToEnabled="True">
                        <Expander.Header>
                            <TextBlock Text="View Controls" Foreground="Black" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Expander.Header>
                        <controls:ZRangeSlider
                            MinValue="{Binding GraphZMin}"
                            MaxValue="{Binding GraphZMax}"
                            LowerValue="{Binding ZFilterMin, Mode=TwoWay}"
                            UpperValue="{Binding ZFilterMax, Mode=TwoWay}"
                            CameraValue="{Binding CameraZ}"
                            Width="80" />
                    </Expander>
                    <!-- Right side controls panel. -->
                    <Expander DockPanel.Dock="Right" ExpandDirection="Left" IsExpanded="False" Background="Orange" sharedUi:Bindings.VisibilityToEnabled="True">
                        <Expander.Header>
                            <TextBlock Text="Node Editor" Foreground="Black" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Expander.Header>
                        <TabControl>
                            <TabItem Header="Node">
                                <controls:NodeInfoPanel x:Name="NodeInfo_Panel"/>
                            </TabItem>
                            <TabItem Header="Properties">
                                <exportloadercontrols:InterpreterExportLoader x:Name="Interpreter_ExportLoader" HideHexBox="True"/>
                            </TabItem>
                        </TabControl>
                    </Expander>
                    <controls:PathfindingNetworkGraphEditor x:Name="GraphEditor"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </xctk:BusyIndicator>
</bases:TrackingNotifyPropertyChangedWindowBase>
