<?xml version="1.0" encoding="utf-8"?>
<!--
  This project is intentionally NOT referenced by LegendaryExplorer.sln. It requires the Wwise SDK
  (WWISEROOT environment variable, set by installing Wwise 2019.1.6.7110 / build 7110) to build,
  which CI and most contributors will not have installed. Open this .vcxproj directly in Visual
  Studio to build it.

  The compiled WwiseAudioPlayer.dll is committed to the repo directly (see
  LegendaryExplorerCore\Libraries\Windows\WwiseAudioPlayer.dll) rather than being built by CI,
  mirroring how CompressionWrappers.dll/ISACTTools.dll are handled. After building, copy the new
  DLL over that file and commit it.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="WinDebug|x64">
      <Configuration>WinDebug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="WinRelease|x64">
      <Configuration>WinRelease</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>WwiseAudioPlayer</ProjectName>
    <ProjectGuid>{D9F415BC-1DDC-4DA1-A2BD-9EC8F27C81A2}</ProjectGuid>
    <RootNamespace>WwiseAudioPlayer</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='WinDebug|X64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='WinRelease|X64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='WinDebug|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='WinRelease|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- WWISEROOT normally comes from the environment (set by the Wwise Launcher installer). This
         fallback only kicks in if it isn't set, so the project still shows a sensible path in the
         IDE rather than a blank one. -->
    <WWISEROOT Condition="'$(WWISEROOT)'==''">C:\Program Files (x86)\Audiokinetic\Wwise 2019.1.6.7110</WWISEROOT>
    <WwiseSDKDir>$(WWISEROOT)\SDK</WwiseSDKDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='WinDebug|X64'">
    <OutDir>..\LegendaryExplorerCore\Libraries\Windows\</OutDir>
    <IntDir>bin\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>WwiseAudioPlayer</TargetName>
    <GenerateManifest>true</GenerateManifest>
    <WwiseSDKLibDir>$(WwiseSDKDir)\x64_vc150\Debug\lib</WwiseSDKLibDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='WinRelease|X64'">
    <OutDir>..\LegendaryExplorerCore\Libraries\Windows\</OutDir>
    <IntDir>bin\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>WwiseAudioPlayer</TargetName>
    <GenerateManifest>true</GenerateManifest>
    <WwiseSDKLibDir>$(WwiseSDKDir)\x64_vc150\Release\lib</WwiseSDKLibDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='WinDebug|X64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/Zc:twoPhase- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_UNICODE;UNICODE;WIN32;_DEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ProgramDataBaseFileName>$(IntDir)$(TargetName).pdb</ProgramDataBaseFileName>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(WwiseSDKDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>AkSoundEngine.lib;AkMemoryMgr.lib;AkStreamMgr.lib;AkMusicEngine.lib;AkVorbisDecoder.lib;CommunicationCentral.lib;dsound.lib;dxguid.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(WwiseSDKLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Manifest>
      <EnableDPIAwareness>false</EnableDPIAwareness>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='WinRelease|X64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- Must match the CRT linkage the prebuilt Wwise Release libs were built with (/MD), or their
           legacy CRT symbol imports (strncpy, _finite, wcsncpy, etc.) fail to resolve against the
           static CRT's libcmt.lib. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/Zc:twoPhase- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_UNICODE;UNICODE;WIN32;NDEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ProgramDataBaseFileName>$(IntDir)$(TargetName).pdb</ProgramDataBaseFileName>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(WwiseSDKDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <!-- CommunicationCentral.lib (Wwise profiler connection) is only shipped for the Debug/Profile
           SDK configs, not Release - the Release build of AkSoundEngine.lib has no dependency on it. -->
      <AdditionalDependencies>AkSoundEngine.lib;AkMemoryMgr.lib;AkStreamMgr.lib;AkMusicEngine.lib;AkVorbisDecoder.lib;dsound.lib;dxguid.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(WwiseSDKLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Manifest>
      <EnableDPIAwareness>false</EnableDPIAwareness>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="DLLMain.cpp" />
    <ClCompile Include="WwiseAudioPlayer.cpp" />
    <ClInclude Include="WwiseAudioPlayer.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
