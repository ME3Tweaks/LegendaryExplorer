<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- RS2008/RS1032 are for analyzer packages shipped to third parties; these diagnostics are internal to this repo. -->
    <NoWarn>$(NoWarn);RS2008;RS1032</NoWarn>
    <!-- Mirrors the configurations used by the rest of the solution so that building
         LegendaryExplorerCore with -c WinDebug etc. resolves this project reference. -->
    <Configurations>Debug;Release;WinDebug;WinRelease;WinAzureRelease;WinAzureTest</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The attributes are this generator's input contract, so it compiles them in rather than matching them
         by name. That makes renaming one of them a build error here instead of a generator that quietly stops
         producing anything.
         This means UIndexRefVerification.cs must not take a dependency on the rest of LegendaryExplorerCore.
         It currently only uses System. If that ever changes, this reference fails to compile and Parser.cs has
         to go back to matching the attributes by string. -->
    <Compile Include="..\LegendaryExplorerCore\Unreal\BinaryConverters\UIndexRefVerification.cs"
             Link="UIndexRefVerification.cs" />
  </ItemGroup>

</Project>
