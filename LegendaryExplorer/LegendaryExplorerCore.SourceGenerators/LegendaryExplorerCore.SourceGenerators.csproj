<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- RS2008/RS1032 are for analyzer packages shipped to third parties; these diagnostics are internal to this repo. -->
    <NoWarn>$(NoWarn);RS2008;RS1032</NoWarn>
    <Configurations>Debug;Release;WinAzureRelease;WinAzureTest</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- DO NOT bump these just to stay current. The Microsoft.CodeAnalysis version here is the MINIMUM compiler
         version that can load this generator. If a build machine's compiler (from its Visual Studio / .NET SDK) is
         older, the generator is silently skipped (warning CS9057) and the build fails with CS0759 on
         UStruct.VerifyExtraUIndexRefs, because the generated half of that partial method is never emitted.
         Only raise this if the generator needs a newer Roslyn API, and only to a version every dev machine and the
         CI agent (VS 2022 17.14 + .NET SDK 10.0.1xx, compiler 5.0.0) can run. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The attributes are this generator's input contract, so it compiles them in rather than matching them
         by name. That makes renaming one of them a build error here instead of a generator that quietly stops
         producing anything.
         This means UIndexRefVerification.cs must not take a dependency on the rest of LegendaryExplorerCore.
         It currently only uses System. If that ever changes, this reference fails to compile and Parser.cs has
         to go back to matching the attributes by string. -->
    <Compile Include="..\LegendaryExplorerCore\Unreal\BinaryConverters\UIndexRefVerification.cs" Link="UIndexRefVerification.cs" />
  </ItemGroup>

</Project>
