# Text is stored with LF in the repository and checked out with CRLF on every machine,
# independent of each developer's core.autocrlf setting.
* text=auto eol=crlf

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.sln     text
*.md      text diff=markdown
*.hlsl    text
*.usf     text
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

# Game and binary assets: never convert.
*.pcc     binary
*.upk     binary
*.u       binary
*.sfm     binary
*.SFM     binary
*.tlk     binary
*.sfar    binary
*.dlc     binary
*.isb     binary
*.bin     binary
*.xxx     binary
*.XXX     binary
*.lextd   binary
*.dll     binary
*.exe     binary
*.snk     binary
*.zip     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.bmp     binary
*.xcf     binary
*.ttf     binary
